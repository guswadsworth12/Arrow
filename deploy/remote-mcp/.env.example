AUTH_DOMAIN=auth.example.com
ARROW_STORY_API_TOKEN=
ARROW_AUTH_DB_PASSWORD=
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=arrow-admin
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=
ARROW_MCP_ALLOW_APPLY=false
