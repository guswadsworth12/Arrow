# Godot 4+ specific ignores
.godot/
/android/

# Arrow ignores
*.arrow
.arrow.config
.arrow.project

# Keep the reproducible importer fixture under version control.
!examples/dialogic_bridge/*.arrow

!examples/dialogic_bridge/story/*.arrow

# Optional story service local state and Python caches
.arrow-service/
__pycache__/
*.py[cod]

# Private self-hosted OAuth deployment settings
deploy/remote-mcp/.env
deploy/remote-mcp/generated/
deploy/remote-mcp/site/
